# 复制为 .env 后按需修改；禁止把真实密钥提交到 Git（标准 28.2）
DJANGO_SETTINGS_MODULE=config.settings.dev

# 必填：生产环境缺失会直接启动报错
DJANGO_SECRET_KEY=please-change-me-to-a-random-64-char-string
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 开发默认 SQLite（可留空走默认值）；生产必须提供 PostgreSQL 连接串
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://reservoir:password@127.0.0.1:5432/reservoir

# 前端联调来源白名单（生产环境不使用 * ）
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
CORS_ALLOW_ALL_ORIGINS=true

# 可选：缓存后端（生产建议 Redis）
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
